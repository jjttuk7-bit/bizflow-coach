# ============================================================
# 클라이언트 (브라우저 번들에 포함됨 — 공개되어도 되는 값만)
# ============================================================
# Supabase anon key는 공개 전제 값이다. 실제 접근 통제는 RLS가 한다.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ============================================================
# 서버 전용 (Vercel Functions에서만 읽음 — 절대 VITE_ 접두사를 붙이지 말 것)
# ============================================================
# VITE_ 를 붙이면 브라우저 번들에 그대로 노출되어 과금을 도난당한다.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# /api/coach가 요청자의 로그인 토큰을 검증할 때 사용.
# VITE_SUPABASE_* 와 같은 값을 넣되, 접두사 없이 별도로 등록해야 한다.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
